#!/bin/bash
# winopen — 윈도우 형식 공유 경로(\\서버\공유\폴더)를 파인더에서 연다.
#   winopen '\\fileserver\share\folder'
#   winopen            # 인자 없으면 클립보드 내용을 쓴다
# 지원 입력: \\host\share\... · //host/share/... · smb://host/share/...(퍼센트 인코딩 해석)
# 환경변수
#   WINOPEN_TAB=0      파인더 새 탭 대신 새 창으로 연다(기본 1 = 파인더 창이 있으면 새 탭)
#   WINOPEN_HOSTS=파일  호스트→IP 매핑 파일(기본 ~/Library/Application Support/WinOpen/hosts.tsv)
set -u
PATH=/usr/bin:/bin:/usr/sbin:/sbin

notify() {  # 앱(클립보드 모드)에서도 보이게 알림 + stderr
  echo "winopen: $1" >&2
  /usr/bin/osascript -e 'on run a' -e 'display notification (item 1 of a) with title "winopen"' -e 'end run' "$1" >/dev/null 2>&1 || true
}
pct_decode() { /usr/bin/perl -pe 's/%([0-9A-Fa-f]{2})/chr hex $1/ge'; }
pct_encode() { /usr/bin/perl -pe 's/([^A-Za-z0-9._~\-])/sprintf("%%%02X", ord $1)/ge'; }
lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

raw=${1-}
[ -z "$raw" ] && raw=$(pbpaste)
# 첫 줄만, 앞뒤 공백 제거, 같은 따옴표로 감싼 경우에만 한 쌍 제거
raw=$(printf '%s' "$raw" | head -n1 | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
case $raw in
  \"*\") raw=${raw#\"}; raw=${raw%\"} ;;
  \'*\') raw=${raw#\'}; raw=${raw%\'} ;;
esac
[ -z "$raw" ] && { notify "경로가 비어 있어"; exit 2; }

is_url=0
case $(lower "${raw:0:6}") in smb://) is_url=1; p=${raw:6} ;; *) p=${raw//\\//} ;; esac
if [ $is_url = 0 ]; then
  case $p in //*) p=${p#//} ;; *) notify "윈도우 공유 경로 형식이 아니야: $raw"; exit 2 ;; esac
fi
p=${p#/}
hostpart=${p%%/*}
rest=${p#"$hostpart"}; rest=${rest#/}
host=${hostpart##*@}         # user@host 는 서버 부분에서만 떼어낸다
share=${rest%%/*}
sub=${rest#"$share"}; sub=${sub#/}
if [ $is_url = 1 ]; then     # URL 입력만 디코딩(UNC 의 리터럴 % 는 그대로)
  case $(lower "$rest") in *%00*|*%0a*|*%0d*) notify "경로에 제어 문자(%00·줄바꿈)가 있어 열지 않아"; exit 2 ;; esac
  share=$(printf '%s' "$share" | pct_decode)
  sub=$(printf '%s' "$sub" | pct_decode)
fi
{ [ -z "$host" ] || [ -z "$share" ]; } && { notify "서버/공유 이름을 못 읽었어: $raw"; exit 2; }
case "/$sub/" in */../*) notify "공유 밖(..)으로 나가는 경로는 열지 않아: $raw"; exit 2 ;; esac

# 호스트명 → IP 매핑(선택). 「호스트<탭>IP」 한 줄씩, 대소문자 무시.
hosts_file=${WINOPEN_HOSTS:-$HOME/Library/Application Support/WinOpen/hosts.tsv}
map_ip() {
  [ -f "$hosts_file" ] || { printf '%s' "$1"; return; }
  local m
  m=$(awk -F'\t' -v h="$1" '!/^#/ && NF>=2 && tolower($1)==tolower(h) {print $2; exit}' "$hosts_file")
  printf '%s' "${m:-$1}"
}
ip=$(map_ip "$host")

# 이미 마운트된 같은 서버·같은 공유를 찾는다(호스트명·IP 어느 쪽으로 붙었든)
find_mount() {
  local line src mhost mshare mp
  while IFS= read -r line; do
    case $line in *"(smbfs"*) ;; *) continue ;; esac
    src=${line%% on *}; src=${src#//}
    mp=${line#* on }; mp=${mp% (smbfs*}
    mhost=${src%%/*}; mhost=${mhost##*@}
    mshare=$(printf '%s' "${src#*/}" | pct_decode)
    [ "$(lower "$mshare")" = "$(lower "$share")" ] || continue
    case "$(lower "$mhost")" in
      "$(lower "$host")"|"$(lower "$ip")") ;;
      *) [ "$(lower "$(map_ip "$mhost")")" = "$(lower "$ip")" ] || continue ;;
    esac
    printf '%s\n' "$mp"; return
  done < <(if [ -n "${WINOPEN_MOUNT_FILE-}" ]; then cat "$WINOPEN_MOUNT_FILE"; else /sbin/mount; fi)
}

[ -n "${WINOPEN_DRY-}" ] && open() { echo "open $*"; }
mp=$(find_mount)
if [ -z "$mp" ]; then
  open "smb://$ip/$(printf '%s' "$share" | pct_encode)" || { notify "마운트 실패: smb://$ip/$share"; exit 1; }
  for _ in $(seq 1 60); do       # 최대 30초 대기(로그인 창이 뜨면 그동안 입력)
    sleep 0.5
    mp=$(find_mount)
    [ -n "$mp" ] && break
  done
  [ -z "$mp" ] && { notify "마운트를 기다리다 시간 초과: $share"; exit 1; }
fi

# 파인더 새 탭으로 연다. 파인더 창이 없거나 권한이 없으면 일반 open 으로 떨어진다.
open_in_tab() {  # $1=폴더, $2=선택할 파일(없으면 빈 값)
  [ "${WINOPEN_TAB:-1}" = 0 ] && return 1
  /usr/bin/osascript - "$1" "$2" >/dev/null 2>&1 <<'APPLESCRIPT'
on run argv
  set dirPath to item 1 of argv
  set selPath to item 2 of argv
  tell application "Finder"
    set nBefore to count of Finder windows
    if nBefore is 0 then error "no window"
    activate
  end tell
  -- 파인더가 앞에 온 걸 확인한 뒤에만 ⌘T 를 보낸다(다른 앱으로 키가 가지 않게)
  repeat 20 times
    tell application "System Events" to set fp to name of first process whose frontmost is true
    if fp is "Finder" then exit repeat
    delay 0.05
  end repeat
  if fp is not "Finder" then error "finder not frontmost"
  tell application "System Events" to keystroke "t" using command down
  -- 탭도 Finder window 로 세어지므로 개수가 늘어야 새 탭이 생긴 것
  set made to false
  repeat 40 times
    delay 0.05
    tell application "Finder" to if (count of Finder windows) > nBefore then set made to true
    if made then exit repeat
  end repeat
  if not made then error "tab not created"
  tell application "Finder"
    set target of front Finder window to (POSIX file dirPath as alias)
    if selPath is not "" then select (POSIX file selPath as alias)
  end tell
end run
APPLESCRIPT
}
show() {  # $1=dir|file $2=경로
  if [ "$1" = file ]; then
    open_in_tab "$(dirname "$2")" "$2" || open -R "$2"
  else
    open_in_tab "$2" "" || open "$2"
  fi
}

# 시험용: WINOPEN_DRY=1 이면 실제로 열지 않고 출력만
[ -n "${WINOPEN_DRY-}" ] && { open_in_tab() { echo "tab $1 | $2"; }; }

target="$mp${sub:+/$sub}"
target=${target%/}
if [ -d "$target" ]; then
  show dir "$target"
elif [ -e "$target" ]; then
  show file "$target"            # 파일이면 파인더에서 선택해서 보여준다
else
  # 없는 경로면 존재하는 가장 가까운 상위 폴더를 연다
  up=$target
  while [ "$up" != "$mp" ] && [ ! -d "$up" ]; do up=$(dirname "$up"); done
  show dir "$up"
  notify "경로가 없어 상위 폴더를 열었어: $(basename "$mp")${up#"$mp"}"
  exit 3
fi
